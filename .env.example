# Copy this file to .env and fill in your own values.
# .env is git-ignored so your secrets never get committed.

# --- Anthropic (Claude) API key ---
# Required for: title lookup (web search), preference analysis, recommendations, and the chatbot.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use. claude-haiku-4-5 is the cost-effective default for this app's
# structured-extraction and short-chat workloads (title lookup, recommendations, chat).
# You can swap this for another Claude model string without changing any code.
CLAUDE_MODEL=claude-haiku-4-5

# Model used specifically for preference-profile synthesis (lib/profile.js), which needs to
# cross-reference/resolve titles across ratings and free-text answers - a cheaper model like
# Haiku doesn't reliably get this right. Optional - defaults to claude-sonnet-5 if unset.
CLAUDE_PROFILE_MODEL=claude-sonnet-5

# --- Database ---
# SQLite file, stored locally on disk - zero setup required.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Used to sign session tokens (see lib/auth.js). Any long random string works.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-this-with-a-long-random-string

# --- Admin ---
# Comma-separated list of account emails allowed to view the internal metrics
# page (/admin/metrics - see lib/admin.js). Everyone else gets a "not
# authorized" message, even if signed in. No schema/DB flag needed - just
# edit this list. Leave unset/empty to disable the page for everyone.
ADMIN_EMAILS=you@example.com
